# SmartKB 私有化部署环境变量模板
# 使用：复制本文件为 .env，按客户环境修改后执行 docker compose up -d

# ---------- 数据库 ----------
POSTGRES_DB=smartkb
POSTGRES_USER=smartkb
POSTGRES_PASSWORD=请修改为强密码

# ---------- 安全 ----------
# JWT 签名密钥，至少 32 字符，随机生成：openssl rand -base64 48
JWT_SECRET_KEY=请替换为至少32字符的随机密钥
# 管理员初始密码（admin 账号），首次登录后请立即修改
# CORS：生产由 Nginx 同源反代，默认不开放任何跨域来源；前端独立域名部署时
#       在 src/SmartKB.Api/appsettings.json 配 SmartKB:CorsAllowedOrigins（数组），切勿用通配符
# 文件存储：路径由 docker-compose.yml 固定为 SmartKB__FileStoragePath=/app/storage，无需在此配置
ADMIN_INITIAL_PASSWORD=请修改为强密码

# ---------- LLM ----------
# Agnes（默认，OpenAI 兼容）/ Cloud = 智谱云 API / Local = 内网 Ollama
# 注意：Agnes 模式下 Chat 走 Agnes，向量化（Embedding）回退智谱，
#       因此 LLM_API_KEY（智谱）仍必填；LLM_AGNES_API_KEY 为 Agnes 对话 Key
LLM_MODE=Agnes
LLM_AGNES_API_KEY=Agnes APIKey（LLM_MODE 非 Agnes 时留空）
LLM_AGNES_BASE_URL=https://apihub.agnes-ai.com/v1
LLM_AGNES_CHAT_MODEL=agnes-3.0-flash
LLM_API_KEY=智谱APIKey（Agnes/Cloud 模式必填，Local 时留空）
LLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
LLM_CHAT_MODEL=glm-4.7
LLM_EMBEDDING_MODEL=embedding-3
# Local 模式：宿主机 Ollama 地址（容器内访问宿主机用 host.docker.internal）
LLM_LOCAL_BASEURL=http://host.docker.internal:11434

# ---------- RAG 运行时（选填） ----------
# 问答行为参数（prompt / topK / 混合检索 / 重排 / 温度）在管理后台「RAG 配置」可视化修改，
# 存 sys_settings，保存后立即生效；此处只放部署级默认值与外部重排模型密钥。
# 安全：ApiKey 只能走环境变量，切勿写进 appsettings.json 或代码库。
# 选用 Api 重排时填 RERANK_API_KEY；未配置或调用失败会自动降级为零依赖的启发式重排。
RERANK_API_KEY=
RERANK_BASE_URL=https://api.siliconflow.cn/v1
RERANK_MODEL=BAAI/bge-reranker-v2-m3

# ---------- 配置化 Agent 工具（P2，选填） ----------
# 后台「工具注册表」可登记内部 HTTP 接口供 LLM 调用。
# 1) 主机白名单：逗号/分号分隔，填了之后后台只能登记这些主机；留空=信任后台登记的地址
TOOLS_ALLOWED_HOSTS=
# 2) 业务系统密钥：在后台只填「环境变量名」（如 ERP_API_TOKEN），绝不把值写进数据库。
#    关键：.env 里的变量不会自动进入容器，必须同时在 docker-compose.yml 的
#    api.environment 中追加一行 `ERP_API_TOKEN: ${ERP_API_TOKEN:-}` 才会注入。
# ERP_API_TOKEN=

# ---------- OpenAI 兼容网关（v1.5，选填，默认关闭） ----------
# 开启后客户现有 ChatGPT 客户端 / 业务系统可直接调用 /v1/chat/completions。
# 1) 必须三项齐备：Enabled=true + 强随机 Key + 一个真实存在的服务账号用户名。
# 2) 服务账号需先在「用户管理」创建并授权知识库，网关权限完全按该账号计算；
#    切勿直接绑 admin，否则这把 Key 能读全部知识库、调用全部工具。
# 3) 鉴权：Authorization: Bearer <GATEWAY_API_KEY>（也接受现有用户 JWT）。
# 4) 建议用 Nginx 对 /v1/ 限流；Key 只走环境变量，不写入 appsettings / 代码库。
GATEWAY_ENABLED=false
GATEWAY_API_KEY=
GATEWAY_SERVICE_USERNAME=
# 默认忽略请求里的 system 消息，统一由后台「RAG 配置」管控系统提示词
GATEWAY_ALLOW_SYSTEM_PROMPT=false

# ---------- LDAP/AD 可选登录（v1.6，选填，默认关闭） ----------
# 开启后：本地密码校验失败再走 LDAP（search-then-bind），验证通过自动开通本地账号并挂 DefaultRole。
# 1) 服务账号：LDAP_BIND_DN + LDAP_BIND_PASSWORD（密码只走环境变量，切勿写入配置文件）；
# 2) DefaultRole 必须是「角色管理」里已存在的角色名，留空则新账号无任何知识库权限，由管理员手动授权；
# 3) 过滤器 {0} 为登录名，默认适配 AD（sAMAccountName）；LDAPS 填 UseSsl=true 且端口 636。
LDAP_ENABLED=false
LDAP_SERVER=ad.corp.local
LDAP_PORT=389
LDAP_USE_SSL=false
LDAP_BASE_DN=DC=corp,DC=local
LDAP_SEARCH_FILTER=(&(objectClass=user)(sAMAccountName={0}))
LDAP_BIND_DN=
LDAP_BIND_PASSWORD=
LDAP_DEFAULT_ROLE=

# ---------- OCR sidecar（v1.6，选填，默认关闭） ----------
# 解析文本过少的 PDF（疑似扫描件）自动调用客户自备 HTTP OCR 服务补文本：
# POST multipart/form-data（字段名 file），响应取 JSON 的 text 字段或纯文本。
# OCR_API_KEY_ENV 填密钥的环境变量名（如 OCR_API_KEY），该变量本身也要在 compose api.environment 注入。
OCR_ENABLED=false
OCR_ENDPOINT=
OCR_API_KEY_ENV=
# OCR_API_KEY=

# ---------- 文档队列（v1.6） ----------
# Memory = 单实例默认（进程内 Channel）；Database = 多实例安全（PostgreSQL SKIP LOCKED 逐条认领）。
# 多实例部署（api 服务 scale>1）必须切 Database，否则文档会重复消费。
QUEUE_MODE=Memory

# ---------- 可观测 ----------
# OTLP 导出地址（如已有 Jaeger/Tempo 填 http://collector:4317），留空则不导出
OTLP_ENDPOINT=

# ---------- 前端 ----------
WEB_PORT=80
