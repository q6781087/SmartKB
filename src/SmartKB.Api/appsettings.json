{
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Default": "Host=localhost;Port=5432;Database=smartkb;Username=smartkb;Password=CHANGE_ME"
  },
  "Jwt": {
    "Issuer": "SmartKB",
    "Audience": "SmartKB",
    "SecretKey": "",
    "ExpireMinutes": 720
  },
  "SmartKB": {
    "AdminInitialPassword": "CHANGE_ME",
    "FileStoragePath": "AppData/files",
    "Chunk": {
      "TargetTokens": 600,
      "OverlapTokens": 100
    }
  },
  "Llm": {
    "Mode": "Agnes",
    "Agnes": {
      "BaseUrl": "https://apihub.agnes-ai.com/v1",
      "ChatModel": "agnes-3.0-flash",
      "ApiKey": ""
    },
    "Cloud": {
      "BaseUrl": "https://open.bigmodel.cn/api/paas/v4",
      "ChatModel": "glm-4.7",
      "EmbeddingModel": "embedding-3",
      "EmbeddingDims": 1024,
      "ApiKey": ""
    },
    "Local": {
      "BaseUrl": "http://localhost:11434",
      "ChatModel": "qwen3:14b",
      "EmbeddingModel": "bge-m3"
    }
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    },
    "WriteTo": [
      { "Name": "Console" },
      {
        "Name": "File",
        "Args": {
          "path": "logs/smartkb-.log",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 30,
          "outputTemplate": "{Timestamp:yyyy-MM-dd HH:mm:ss.fff} [{Level:u3}] {TraceId} {SourceContext} {Message:lj}{NewLine}{Exception}"
        }
      }
    ]
  }
}
